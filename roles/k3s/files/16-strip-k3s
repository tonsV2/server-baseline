#!/bin/sh
# netfilter-persistent plugin, run after 15-ip4tables has saved the IPv4 rules: removes the rules
# k3s, its CNI plugins and flannel wrote, which refer to state that does not exist at boot.
set -e

rules=/etc/iptables/rules.v4

case "$1" in
save)
    [ -f "$rules" ] || exit 0
    tmp=$(mktemp "$rules.XXXXXX")
    grep --invert-match --ignore-case -e kube- -e cni- -e flannel "$rules" > "$tmp" || true
    chmod --reference="$rules" "$tmp"
    mv "$tmp" "$rules"
    ;;
esac
