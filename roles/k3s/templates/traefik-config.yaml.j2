apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    service:
      type: ClusterIP
    # One node and a host port: the new pod cannot start while the old one holds the port, so the old
    # one goes first.
    updateStrategy:
      type: RollingUpdate
      rollingUpdate:
        maxUnavailable: 1
        maxSurge: 0
    ports:
      web:
        expose:
          default: false
      websecure:
        hostPort: {{ k3s_traefik_https_port }}
{% if k3s_traefik_trusted_ips | length > 0 %}
        # The X-Forwarded-* headers of connections from these addresses are kept, so what is behind
        # traefik sees the client the proxy in front saw rather than the proxy
        forwardedHeaders:
          trustedIPs: {{ k3s_traefik_trusted_ips | to_json }}
{% endif %}
