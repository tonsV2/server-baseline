# Every TLS connection to traefik must present a client certificate signed by this CA, so the host
# answers only the proxy in front that holds one, Cloudflare's origin pull certificate say. A
# TLSOption named default applies to every router that names no other.
apiVersion: v1
kind: Secret
metadata:
  name: traefik-client-ca
  namespace: kube-system
type: Opaque
stringData:
  tls.ca: |
    {{ k3s_traefik_client_ca | trim | indent(4) }}
---
apiVersion: traefik.io/v1alpha1
kind: TLSOption
metadata:
  name: default
  namespace: kube-system
spec:
  minVersion: VersionTLS12
  clientAuth:
    secretNames:
      - traefik-client-ca
    clientAuthType: RequireAndVerifyClientCert
